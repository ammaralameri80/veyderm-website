# Veyderm — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# .env / .env*.local are gitignored. In production, set these as Vercel env vars.

# --- Supabase (scaffold only; not wired to any data in this build) ---
# Public URL of the Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for READING leads back (bypasses RLS). NOT prefixed with
# NEXT_PUBLIC so it never ships to the browser. The website form only INSERTS
# (via the anon key + RLS policy), so this is optional and only needed if you
# add a server-side admin/export feature. NEVER commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Canonical site origin, used for metadata/canonical/sitemap. Defaults to
# https://www.veyderm.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.veyderm.com

# --- Analytics ---
# Google Analytics 4 measurement ID (safe to expose). When unset, no analytics
# script loads. Even when set, GA loads only after the visitor accepts the
# cookie-consent banner.
NEXT_PUBLIC_GA_ID=
